  "policy": [
    "Disk/image formats are separate from ordinary archive formats.",
    "Raw images are never blindly extracted as archives.",
    "Image readers must validate signatures and bounds before exposing files.",
    "Image writers are disabled until a real, tested writer exists."
  ]
